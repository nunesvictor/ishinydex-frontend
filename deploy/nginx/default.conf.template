# Servidor do iShinyDex: entrega o app Flutter e repassa a API para o backend.
# Tudo na mesma origem (http://<host>:<porta>), então o navegador não aplica
# CORS e os sprites de /media carregam normalmente.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 10m;

    # O mime.types do nginx não conhece .mjs, e o navegador só carrega um
    # módulo JavaScript (o main.dart.mjs do build --wasm) com o tipo certo.
    include /etc/nginx/mime.types;
    types {
        application/javascript mjs;
    }

    gzip on;
    gzip_types text/plain text/css application/javascript application/json application/wasm image/svg+xml;
    gzip_min_length 1024;

    # ---- Backend (Django/uwsgi) ----
    # O nome do backend é resolvido a cada requisição (proxy_pass com
    # variável + resolver), e não só ao iniciar: assim o nginx sobe e serve o
    # app mesmo com o backend fora do ar, respondendo 502 só nestas rotas.
    # ${NGINX_LOCAL_RESOLVERS} é o DNS do container (no Docker, 127.0.0.11),
    # preenchido pela imagem oficial (NGINX_ENTRYPOINT_LOCAL_RESOLVERS).
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $backend ${BACKEND_URL};

    # Host preservado: o Django gera URLs absolutas (sprites) com o mesmo
    # endereço que o navegador usou.
    location ~ ^/(api|media|static|admin)/ {
        proxy_pass $backend;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # ---- App Flutter ----
    # Endereços versionados (/v/<hash>/main.dart.js, /v/<hash>/assets/...):
    # o hash muda a cada build, então o conteúdo de um endereço nunca muda e o
    # navegador pode guardá-lo por um ano. Apontam para os arquivos da raiz.
    location ~ ^/v/[0-9a-f]+/(.*)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files /$1 =404;
    }

    # Todo o resto (index.html, flutter_bootstrap.js, ícones...) tem nome
    # fixo: o navegador revalida sempre (ETag → 304 quando nada mudou).
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
