# Servidor do iShinyDex: entrega o app Flutter e repassa a API para o backend.
# Tudo na mesma origem (http://<host>:<porta>), então o navegador não aplica
# CORS e os sprites de /media carregam normalmente.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 10m;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json application/wasm image/svg+xml;
    gzip_min_length 1024;

    # ---- Backend (Django/uwsgi) ----
    # Host preservado: o Django gera URLs absolutas (sprites) com o mesmo
    # endereço que o navegador usou.
    location ~ ^/(api|media|static|admin)/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # ---- App Flutter ----
    # Arquivos que mudam a cada deploy: o navegador sempre revalida.
    location ~ ^/(index\.html|flutter_bootstrap\.js|flutter_service_worker\.js|manifest\.json|version\.json)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "public, max-age=604800";
        try_files $uri $uri/ /index.html;
    }
}
