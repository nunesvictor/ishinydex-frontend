# Copie para .env e ajuste se necessário (o docker compose lê automaticamente).

# Porta do host onde o app fica disponível: http://<ip-do-pc>:X_WEB_PORT
X_WEB_PORT=8090

# Backend para onde o nginx repassa /api, /media, /static e /admin.
# host.docker.internal = a própria máquina (fora do container).
# 8080 = serviço `prod` do ishinydex-backend; 8008 = serviço `web` (dev).
BACKEND_URL=http://host.docker.internal:8080
